# ===========================
# App Config
# ===========================
APP_NAME=lti-app
APP_CONTAINER_NAME=lti-app
APP_DOMAIN=app.localhost       # Domain Traefik will route to
APP_PORT=3000                  # Exposed only in dev
NODE_ENV=development
DEBUG=express:*                # Debug logs for dev

# LTI Provider secret (used for signing JWTs)
LTI_KEY=supersecret

# ===========================
# Database Config (MongoDB)
# ===========================
MONGO_VERSION=6.0
DB_USER=admin
DB_PASS=adminpassword
DB_NAME=ltiapp
DB_HOST=mongo                  # Service name from docker-compose
DB_PORT=27017

# ===========================
# Traefik Config
# ===========================
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Basic auth for Traefik dashboard
# Format: user:hashedpassword
# Generate with: htpasswd -nb admin strongpassword | sed -e s/\\$/\\$\\$/g
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$uJdD09eX$$abc123xyz456def789

# ===========================
# LTI Tool Provider Config
# ===========================
TOOL_PROVIDER_URL=https://app.localhost
TOOL_PROVIDER_NAME=LTI Sample Tool
TOOL_PROVIDER_LOGO=https://app.localhost/logo.png
TOOL_PROVIDER_DESCRIPTION=An example LTI tool for testing integrations
TOOL_PROVIDER_REDIRECT_URIS=https://app.localhost/login,https://app.localhost/other-callback
TOOL_PROVIDER_AUTO_ACTIVATE=true

# ===========================
# Platform (LMS) Config
# ===========================
# Example: Canvas / Moodle / Blackboard instance
PLATFORM_URL=https://canvas.example.edu
PLATFORM_NAME=Canvas Demo
PLATFORM_CLIENT_ID=1234567890abcdef
PLATFORM_AUTH_ENDPOINT=https://canvas.example.edu/api/lti/authorize_redirect
PLATFORM_TOKEN_ENDPOINT=https://canvas.example.edu/login/oauth2/token
PLATFORM_KEYSET_ENDPOINT=https://canvas.example.edu/api/lti/security/jwks
